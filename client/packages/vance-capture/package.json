{
  "name": "@vance/vance-capture",
  "version": "0.1.0",
  "private": true,
  "description": "Vancetope Capture \u2014 browser extension that saves the current page into a Vancetope link list. Chrome (MV3); Firefox and Safari are follow-ups.",
  "license": "SEE LICENSE IN ../../LICENSE.txt",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "icons": "bash scripts/icons.sh",
    "safari": "bash scripts/safari.sh",
    "clean": "rm -rf dist dist-types safari *.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@vance/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "typescript": "^5.9.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
