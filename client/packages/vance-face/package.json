{
  "name": "@vance/vance-face",
  "version": "1.0.0",
  "private": true,
  "description": "Vance Web-UI: Vue 3 + Vite + Tailwind + DaisyUI multi-page app. One HTML entry per editor.",
  "license": "SEE LICENSE IN ../../LICENSE.txt",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:1": "FACE_PORT=9901 BRAIN_PORT=9991 vite",
    "dev:2": "FACE_PORT=9902 BRAIN_PORT=9992 vite",
    "build": "vue-tsc -b && vite build",
