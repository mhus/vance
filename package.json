{
  "name": "vance-client",
  "version": "1.0.0",
  "private": true,
  "description": "Vance Web-UI workspace — pnpm monorepo with @vance/generated, @vance/shared, @vance/vance-face.",
  "license": "SEE LICENSE IN LICENSE.txt",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @vance/vance-face dev",
    "lint": "eslint .",
    "clean": "pnpm -r exec rm -rf dist node_modules/.vite tsconfig.tsbuildinfo"
  },
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "overrides": {
      "yallist": "4.0.0",
      "@module-federation/vite": "1.20.1"
    },
    "patchedDependencies": {
      "tiptap-extension-global-drag-handle": "patches/tiptap-extension-global-drag-handle.patch"
    }
  }
}
