<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.mhus.vance</groupId>
    <artifactId>plugins</artifactId>
    <version>0.4.0-SNAPSHOT</version>
    <name>plugins</name>
    <description>
        Aggregator for build-time Maven plugins used by the Vance reactor.
        Intentionally does NOT inherit from the Spring-Boot-based Vance parent POM —
        plugin builds have distinct concerns (plugin-descriptor generation, provided-scope
        Maven API, Java-version constraints set by the Maven runtime) and should not pick
        up runtime conventions from the server stack.
    </description>
    <packaging>pom</packaging>

    <!-- Mirrors the Spotless config from the Vance parent POM (server/pom.xml).
         Kept inline here because this aggregator deliberately has no parent;
         when changing formatter or rules, change both places. -->
    <properties>
        <spotless.maven.version>3.10.2</spotless.maven.version>
        <spotless.palantir.version>2.97.0</spotless.palantir.version>
        <spotless.ratchetFrom>origin/main</spotless.ratchetFrom>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.maven.version}</version>
                <configuration>
                    <ratchetFrom>${spotless.ratchetFrom}</ratchetFrom>
                    <java>
                        <palantirJavaFormat>
                            <version>${spotless.palantir.version}</version>
                        </palantirJavaFormat>
                        <importOrder/>
                        <removeUnusedImports/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>validate</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>generate-java-to-ts-maven-plugin</module>
    </modules>

</project>
