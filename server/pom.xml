    <artifactId>vance</artifactId>
    <version>0.3.0-SNAPSHOT</version>
    <name>vance</name>
    <description>AI Multi-Agent Orchestration Platform</description>
    <packaging>pom</packaging>

    <modules>
        <module>plugins</module>
        <module>vance-api</module>
        <module>vance-toolpack</module>
        <module>vance-shared</module>
        <module>vance-brain</module>
        <module>vance-foot</module>
        <module>vance-anus</module>
        <module>vance-addon-shared-simpleauth</module>
        <module>vance-addon-brain-simpleauth</module>
        <module>vance-addon-anus-simpleauth</module>
        <module>vance-addon-brain-slideshow</module>
        <module>vance-addon-brain-kanban</module>
        <module>vance-addon-brain-calendar</module>
        <module>vance-addon-brain-workbook</module>
        <module>vance-addon-brain-wiki</module>
        <module>vance-addon-brain-journal</module>
        <module>vance-addon-brain-gtd</module>
        <module>vance-addon-brain-issues</module>
        <module>vance-addon-brain-canvas</module>
        <module>vance-addon-brain-finance</module>
        <module>vance-addon-brain-binder</module>
        <module>vance-addon-brain-centauri</module>
        <module>vance-addon-brain-zarniwoop</module>
