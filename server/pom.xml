    <properties>
        <java.version>25</java.version>
        <lombok.version>1.18.46</lombok.version>
        <spring.boot.version>4.1.0</spring.boot.version>
        <langchain4j.version>1.18.1</langchain4j.version>
        <langgraph4j.version>1.8.23</langgraph4j.version>
        <picocli.version>4.7.7</picocli.version>
        <jspecify.version>1.0.1</jspecify.version>
        <jjwt.version>0.13.0</jjwt.version>
        <console-master.version>1.0.0-SNAPSHOT</console-master.version>
        <jline.version>4.3.1</jline.version>
        <lanterna.version>3.1.5</lanterna.version>
        <graaljs.version>25.2.4</graaljs.version>
        <jgit.version>7.7.1.202607240634-r</jgit.version>
        <anthropic.sdk.version>2.52.0</anthropic.sdk.version>
        <!-- swagger-parser 2.x supports both OpenAPI 3.x and Swagger 2.x. Used by
             RestApiToolPackFactory to materialise REST-API packs into Vance Tools. -->
        <swagger.parser.version>2.1.46</swagger.parser.version>
        <!-- HTML → text extraction for WebFetchTool's 'text' flag. Robust against
             broken markup, drops script/style content, decodes entities. -->
        <jsoup.version>1.23.1</jsoup.version>
        <!-- PDFBox: PDF→text fallback for providers/models without
             native PDF vision (OpenAI lc4j adapter, Ollama, LM Studio).
             Streamed: AttachmentResolver passes an InputStream straight
             into PDFBox's Loader, no full-file byte[] held twice. -->
        <pdfbox.version>3.0.8</pdfbox.version>
        <!-- Pebble: Jinja2-style template engine for recipe / engine prompt
             templating. ~150 KB with slf4j as only transitive dep. Drives
             tier/mode/profile-aware prompt rendering — see
             planning/prompt-template-migration.md. -->
        <pebble.version>4.1.2</pebble.version>
        <angus.mail.version>2.0.5</angus.mail.version>
        <greenmail.version>2.1.12</greenmail.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Build stamp injected into application.yml via the resource filtering
             that spring-boot-starter-parent already enables (@…@ delimiter) so
             brain/anus/foot report the real Maven release version at runtime
             (vance.build.version / vance.build.time). The indirection through a
             project property is the documented workaround for MRESOURCES-99 —
             a bare @maven.build.timestamp@ otherwise filters to an empty string. -->
        <build.timestamp>${maven.build.timestamp}</build.timestamp>
        <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ss'Z'</maven.build.timestamp.format>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.bsc.langgraph4j</groupId>
                <artifactId>langgraph4j-bom</artifactId>
                <version>${langgraph4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli-spring-boot-starter</artifactId>
                <version>${picocli.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jline</groupId>
                <artifactId>jline</artifactId>
                <version>${jline.version}</version>
            </dependency>
            <dependency>
                <groupId>com.googlecode.lanterna</groupId>
                <artifactId>lanterna</artifactId>
                <version>${lanterna.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jspecify</groupId>
                <artifactId>jspecify</artifactId>
                <version>${jspecify.version}</version>
            </dependency>
            <dependency>
                <!-- Eclipse Angus Mail — the reference impl of Jakarta Mail.
                     IMAP + SMTP clients used by imap_mailbox / smtp_sender
                     server-tool factories. Spring Boot 4 doesn't pull this
                     in by default since spring-boot-starter-mail is opt-in. -->
                <groupId>org.eclipse.angus</groupId>
                <artifactId>angus-mail</artifactId>
                <version>${angus.mail.version}</version>
            </dependency>
            <dependency>
                <!-- Test-only: in-process IMAP + SMTP server for the
                     imap/smtp factory integration tests. -->
                <groupId>com.icegreen</groupId>
                <artifactId>greenmail-junit5</artifactId>
                <version>${greenmail.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>de.mhus</groupId>
                <artifactId>console-master-core</artifactId>
                <version>${console-master.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>org.graalvm.polyglot</groupId>
                <artifactId>polyglot</artifactId>
                <version>${graaljs.version}</version>
            </dependency>
            <dependency>
                <groupId>org.graalvm.polyglot</groupId>
                <artifactId>js-community</artifactId>
                <version>${graaljs.version}</version>
                <type>pom</type>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jgit</groupId>
                <artifactId>org.eclipse.jgit</artifactId>
                <version>${jgit.version}</version>
            </dependency>
            <dependency>
                <groupId>io.swagger.parser.v3</groupId>
                <artifactId>swagger-parser</artifactId>
                <version>${swagger.parser.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jsoup</groupId>
                <artifactId>jsoup</artifactId>
                <version>${jsoup.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
            <dependency>
                <groupId>io.pebbletemplates</groupId>
                <artifactId>pebble</artifactId>
                <version>${pebble.version}</version>
            </dependency>
            <!--
                Direct Anthropic SDK — used by AnthropicDirectChatModel for
                prompt-caching support that langchain4j-anthropic doesn't
                expose. The SDK pulls Jackson 2 transitively, which Spring
                Boot 4 only registers as Jackson 3; the SDK's internals stay
                self-contained, our own code stays Jackson 3 (enforcer-banned
                Jackson 2 imports). Both layers coexist via the existing
                transitive Jackson 2 that langchain4j already drags in.
            -->
            <dependency>
                <groupId>com.anthropic</groupId>
                <artifactId>anthropic-java</artifactId>
                <version>${anthropic.sdk.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Publishes one build property per resolved dependency, named
                `groupId:artifactId:type` and holding the jar's path in the local
                repository. Sole consumer is the Mockito `-javaagent` in the
                Surefire argLine below (see the comment there for why the agent
                has to be on the command line); the goal is otherwise a no-op.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>dependency-jar-properties</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        Test classes are distributed over four reusing forks.
                        Tests are the dominant build cost (~52% of a full
                        `mvn clean install`), and they concentrate in the two
                        modules on the reactor's critical path: vance-shared
                        (1098 tests) and vance-brain (4260). Splitting them
                        measured 36s -> 26s for brain and 25s -> 18s for
                        shared on an 18-core machine.

                        Second effect: it caps how many test classes share a
                        single JVM. Running all 4260 brain tests in one fork
                        was hitting a metaspace flake (NoClassDefFoundError
                        on inner classes) — four forks keep each JVM well
                        below that threshold.

                        Requires tests to not share process-global state
                        across classes (fixed ports, fixed temp paths,
                        static singletons written by one class and read by
                        another). That holds today; a new test that breaks it
                        shows up as a failure only under forking, so keep it
                        in mind when a test passes solo but fails in the
                        reactor.
                    -->
                    <forkCount>4</forkCount>
                    <reuseForks>true</reuseForks>
                    <!--
                        Mockito's inline-mock-maker (the 5.x default) rewrites
                        bytecode of already-loaded classes, which needs a JVM
                        instrumentation agent. Left alone, Mockito attaches that
                        agent to the running JVM itself ("self-attach") and warns
                        that this stops working in a future JDK — JEP 451
                        deprecated self-attaching for removal in JDK 21. Passing
                        the agent at JVM start is the supported route and drops
                        the warning; `-XX:+EnableDynamicAgentLoading` (which only
                        muted the JDK-side half of the same complaint) is gone
                        with it, so a *new* library that starts self-attaching
                        shows up in the log instead of hiding behind our flag.

                        The path expands to mockito-core's jar in the local
                        repository: `dependency:properties` (declared above) defines
                        one property per resolved dependency, named
                        `groupId:artifactId:type`. So the version stays wherever
                        it comes from (spring-boot-starter-test) and is never
                        spelled out twice. Surefire does NOT resolve that
                        expression on its own — without the dependency-plugin
                        execution the fork dies with "Error opening zip file or
                        JAR manifest missing". Modules without tests never fork a
                        JVM, so an unsubstituted expression there is inert.
                    -->
                    <argLine>
                        -javaagent:${org.mockito:mockito-core:jar}
                        --add-opens java.base/java.lang=ALL-UNNAMED
                        --add-opens java.base/java.lang.reflect=ALL-UNNAMED
                        --add-opens java.base/java.util=ALL-UNNAMED
                    </argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!--
                Banishes Jackson 2.x runtime API (databind/core) from our own
                source. langchain4j drags Jackson 2 in transitively, so the
                classes resolve at compile time even though Spring Boot 4 only
                wires up the Jackson 3 (`tools.jackson.*`) ObjectMapper bean —
                if we accidentally `import com.fasterxml.jackson.databind.*`,
                the Bean lookup blows up at startup, not at compile.

                Annotations (`com.fasterxml.jackson.annotation.*`) stay allowed
                because Jackson 3 understands them and our existing DTOs use
                them throughout. Only databind/core are off-limits.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>no-jackson2-runtime-api</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <restrictImports>
                                    <reason>Use tools.jackson.* (Jackson 3) — Spring Boot 4 only registers a Jackson 3 ObjectMapper bean. com.fasterxml.jackson.annotation.* is fine, but databind/core must not be referenced from our code.</reason>
                                    <bannedImports>
                                        <bannedImport>com.fasterxml.jackson.databind.**</bannedImport>
                                        <bannedImport>com.fasterxml.jackson.core.**</bannedImport>
                                    </bannedImports>
                                </restrictImports>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>de.skuzzle.enforcer</groupId>
                        <artifactId>restrict-imports-enforcer-rule</artifactId>
                        <version>3.0.0</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>

</project>
