{
  "name": "@vance-addon/binder",
  "version": "1.0.0",
  "private": true,
  "description": "Client surface of the Binder Brain addon. Registers the application:binder app kind — a section-grouped, drag-and-drop list of references to arbitrary project documents, rendered per-kind read-only with a deep-link into Cortex for editing.",
  "license": "SEE LICENSE IN ../../../../client/LICENSE.txt",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["src", "dist"],
  "scripts": {
    "build": "vue-tsc -b && vite build",
    "dev": "vite",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@vance/components": "workspace:*",
    "@vance/kind-registry": "workspace:*",
    "@vance/shared": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.20.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "vite": "^8.2.0",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.8"
  }
}
