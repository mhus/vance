{
  "name": "@vance-addon/calendar",
  "version": "1.0.0",
  "private": true,
  "description": "Client surface of the Calendar Brain addon — TypeScript DTOs (generated from Java), REST helpers, the Vue planner editor (AppEditor) and the per-document Calendar Kind view + codec. Federation remote consumed by vance-face.",
  "license": "SEE LICENSE IN ../../../../client/LICENSE.txt",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./CalendarPlanner.vue": {
      "types": "./dist/CalendarPlanner.vue.d.ts",
      "import": "./src/CalendarPlanner.vue"
    },
    "./CalendarView.vue": {
      "types": "./dist/CalendarView.vue.d.ts",
      "import": "./src/CalendarView.vue"
    },
    "./TimelineView.vue": {
      "types": "./dist/TimelineView.vue.d.ts",
      "import": "./src/TimelineView.vue"
    }
  },
  "files": ["src", "dist"],
  "scripts": {
    "build": "vue-tsc -b && vite build",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@vance/components": "workspace:*",
    "@vance/kind-registry": "workspace:*",
    "@vance/shared": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.20.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9"
  }
}
