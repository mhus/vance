{
  "name": "@vance-addon/contacts",
  "version": "1.0.0",
  "private": true,
  "description": "Client surface of the Contacts addon. Registers the contact document kind (a card with picture, inline or a reference into the address book) and exposes the ./area address book the landing tile opens.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "vue-tsc -b && vite build",
    "dev": "vite",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@vance/components": "workspace:*",
    "@vance/generated": "workspace:*",
    "@vance/kind-registry": "workspace:*",
    "@vance/shared": "workspace:*",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "vue-draggable-plus": "^0.6.1"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.23.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "vite": "^8.3.4",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.13"
  }
}
