{
  "name": "@vance-addon/finance",
  "version": "1.0.0",
  "private": true,
  "description": "Client surface of the Finance Brain addon. Registers the kind: finance-tree editor (hierarchical income/expense model) rendered in Cortex.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["src", "dist"],
  "scripts": {
    "build": "vue-tsc -b && vite build",
    "dev": "vite",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@vance/components": "workspace:*",
    "@vance/generated": "workspace:*",
    "@vance/kind-registry": "workspace:*",
    "@vance/shared": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.23.10",
    "@vitejs/plugin-vue": "^6.0.10",
    "vite": "^8.3.6",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  }
}
