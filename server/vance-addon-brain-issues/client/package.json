{
  "name": "@vance-addon/issues",
  "version": "1.0.0",
  "private": true,
  "description": "Client surface of the Issues Brain addon. Registers the application:issues kind — Open/Closed/Archived tabs, issue detail with state toggle + comment thread, search.",
  "license": "SEE LICENSE IN ../../../../client/LICENSE.txt",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "vue-tsc -b && vite build",
    "dev": "vite",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@vance/block-editor": "workspace:*",
    "@vance/components": "workspace:*",
    "@vance/kind-registry": "workspace:*",
    "@vance/shared": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.21.1",
    "@tiptap/core": "^3.30.5",
    "@tiptap/vue-3": "^3.30.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "vite": "^8.2.2",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
