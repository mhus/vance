{
  "name": "@vance-addon/scribble",
  "version": "1.0.0",
  "private": true,
  "description": "Client surface of the Scribble Brain addon. Registers the handwriting kind: scribble (editable sheet), rendered with a two-layer canvas pen editor on perfect-freehand ink.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["src", "dist"],
  "scripts": {
    "build": "vue-tsc -b && vite build",
    "dev": "vite",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vance/components": "workspace:*",
    "@vance/kind-registry": "workspace:*",
    "@vance/shared": "workspace:*",
    "perfect-freehand": "^1.2.3"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.23.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.13"
  }
}
