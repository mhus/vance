{
  "name": "@vance-addon/store",
  "version": "1.0.0",
  "private": true,
  "description": "Client surface of the store Brain addon \u2014 the federated store area consumed by vance-face.",
  "license": "SEE LICENSE IN ../../../../client/LICENSE.txt",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./StoreArea.vue": {
      "types": "./dist/StoreArea.vue.d.ts",
      "import": "./src/StoreArea.vue"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "vue-tsc -b && vite build",
    "dev": "vite",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@vance/components": "workspace:*",
    "@vance/shared": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.20.7",
    "@vitejs/plugin-vue": "^6.0.8",
    "vite": "^8.2.2",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.11"
  }
}
