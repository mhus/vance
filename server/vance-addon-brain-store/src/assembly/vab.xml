<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.1"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.1 https://maven.apache.org/xsd/assembly-2.1.1.xsd">
    <!--
      Descriptor for the brain-side store addon's .vab bundle.
      Layout per specification/addon-system.md §9.1:

        META-INF/vance-addon.yaml   ← bootstrap reads this (id, version, host, tile)
        brain/lib/*.jar             ← this module's own JAR
        face/                       ← the store federation remote

      No dependencySet: everything this addon needs is on the Brain's base
      classpath. It talks to the store over HTTP, so none of the EE store
      classes ride along — which is the point of the addon being a client
      rather than an embedded copy of the store.
    -->
    <id>vab</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>

    <files>
        <file>
            <source>${project.build.directory}/${project.build.finalName}.jar</source>
            <outputDirectory>brain/lib</outputDirectory>
        </file>
        <file>
            <source>${project.build.outputDirectory}/META-INF/vance-addon.yaml</source>
            <outputDirectory>META-INF</outputDirectory>
        </file>
    </files>

    <fileSets>
        <fileSet>
            <directory>${project.build.outputDirectory}/META-INF/spring</directory>
            <outputDirectory>META-INF/spring</outputDirectory>
        </fileSet>

        <!--
          Federation remote: the permission-grants frontend produced by
          `vite build` in client/. The brain bootstrap symlinks the face/
          subtree into nginx's serve root, so remoteEntry.js becomes
          reachable at /addons/<id>-<ver>/remoteEntry.js. The dev-only
          index.html stub is excluded — production has no standalone HTML
          entry for the remote.
        -->
        <fileSet>
            <directory>${project.basedir}/client/dist</directory>
            <outputDirectory>face</outputDirectory>
            <excludes>
                <exclude>index.html</exclude>
                <exclude>@mf-types/**</exclude>
            </excludes>
        </fileSet>
    </fileSets>
</assembly>
