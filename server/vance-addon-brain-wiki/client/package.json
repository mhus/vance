{
  "name": "@vance-addon/wiki",
  "version": "1.0.0",
  "private": true,
  "description": "Client surface of the Wiki Brain addon. Registers the application:wiki kind and reuses @vance/block-editor's WorkPageEditor with wikilink resolution injected.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "vue-tsc -b && vite build",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@vance/block-editor": "workspace:*",
    "@vance/components": "workspace:*",
    "@vance/generated": "workspace:*",
    "@vance/kind-registry": "workspace:*",
    "@vance/shared": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.23.10",
    "@tiptap/core": "^3.33.0",
    "@tiptap/vue-3": "^3.33.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  }
}
