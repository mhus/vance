{
  "name": "@vance-addon/workbook",
  "version": "1.0.0",
  "private": true,
  "description": "Client surface of the Workbook + Canvas Brain addon. Registers two kinds (canvas, application:workbook) and consumes @vance/block-editor as its shared editor implementation.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "vue-tsc -b && vite build",
    "dev": "vite",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@vance/block-editor": "workspace:*",
    "@vance/components": "workspace:*",
    "@vance/kind-registry": "workspace:*",
    "@vance/shared": "workspace:*",
    "emoji-picker-element": "^1.29.1"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.23.4",
    "@tiptap/core": "^3.31.4",
    "@tiptap/vue-3": "^3.31.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "vite": "^8.3.4",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.13"
  }
}
