<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.mhus.vance</groupId>
        <artifactId>vance</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>vance-anus-all</artifactId>
    <name>vance-anus-all</name>
    <description>Dev-bundle Anus build: ships vance-anus plus every first-party anus addon JAR on the classpath. Used as the IDE launch target — VanceAnusAllApplication delegates to VanceAnusApplication so its @SpringBootApplication still scans anus + shared while Spring discovers the addons via their META-INF/spring/AutoConfiguration.imports files. Not the production deployment unit; the Docker image loads addons via -Dloader.path.</description>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>de.mhus.vance</groupId>
            <artifactId>vance-anus</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Permission provider: Simple-Auth is the only provider. The anus
             context scans vance-shared and instantiates PermissionService, so
             it must satisfy the mandatory single-provider guard. The shared
             core carries the resolver; the anus module carries the CRUD
             commands. These are addons — pulled at runtime only and discovered
             via their META-INF/spring/AutoConfiguration.imports; nothing here
             compiles against them, hence runtime scope (not a hard dependency). -->
        <dependency>
            <groupId>de.mhus.vance</groupId>
            <artifactId>vance-addon-shared-simpleauth</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>de.mhus.vance</groupId>
            <artifactId>vance-addon-anus-simpleauth</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>de.mhus.vance.anus.all.VanceAnusAllApplication</mainClass>
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
